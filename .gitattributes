# 줄바꿈 정규화
# core.autocrlf 개인 설정과 무관하게 저장소 전체를 LF로 통일한다.
# (Prettier 의 endOfLine: "lf" 와 어긋나 무한 diff 가 나는 것을 막는다)
* text=auto eol=lf

# Windows 배치 파일은 CRLF 여야 실행된다
*.cmd text eol=crlf
*.bat text eol=crlf

# 바이너리는 변환하지 않는다
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary

# 자동 생성 파일은 diff 에서 접어 둔다
package-lock.json linguist-generated=true -diff
